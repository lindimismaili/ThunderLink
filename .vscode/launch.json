{
    // Debug configurations for ThunderLink.
    //   * "Windows: Debug Receiver" — needs the C/C++ extension (ms-vscode.cpptools)
    //   * "Mac: Debug Sender"       — needs CodeLLDB (vadimcn.vscode-lldb) or the Swift extension
    // Both run the cross-platform "Build" task first, then launch under the debugger.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Windows: Debug Receiver",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/windows_receiver/build/Debug/ThunderLink.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "Build"
        },
        {
            "name": "Mac: Debug Sender",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/mac_sender/.build/debug/ThunderLinkSender",
            "args": [],
            "cwd": "${workspaceFolder}/mac_sender",
            "preLaunchTask": "Build"
        }
    ]
}
