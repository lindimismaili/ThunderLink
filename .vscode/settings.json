{
    // Native VSCode periodic git fetch. Keeps origin/main fresh and shows the
    // incoming-commit (down-arrow) indicator in the status bar. The
    // "Git: Auto-sync (Claude-resolved)" task in tasks.json does the actual
    // pull + conflict resolution when it sees origin/main has moved.
    "git.autofetch": "all",
    "git.autofetchPeriod": 60,
    // Safer manual pulls when you have local edits.
    "git.autoStash": true
}
