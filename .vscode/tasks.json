{
    // ThunderLink dev tasks.
    //   * "Windows: Dev (Build & Run Receiver)"  — run on the Windows PC
    //   * "Mac: Dev (Build & Run Sender)"         — run on the Mac
    // Run with: Terminal > Run Task...  (or Ctrl/Cmd+Shift+B for the default build).
    // Defaults target the direct USB-C->Ethernet link (169.254.1.1 Mac / 169.254.1.2 PC),
    // so no arguments are needed. Add e.g. ["--peer","169.254.1.2"] to the args to override.
    "version": "2.0.0",
    "tasks": [
        // ---------------- Windows (receiver) ----------------
        {
            "label": "Windows: Configure (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": ["-B", "build", "-S", "windows_receiver"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            // Kill any running instance so the linker can overwrite the .exe.
            // Succeeds whether or not it was running (PowerShell default shell).
            "label": "Windows: Stop Receiver",
            "type": "shell",
            "command": "Stop-Process -Name ThunderLinkReceiver -Force -ErrorAction SilentlyContinue; exit 0",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "silent", "panel": "shared" }
        },
        {
            "label": "Windows: Build (CMake Debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--config", "Debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["Windows: Configure (CMake)", "Windows: Stop Receiver"],
            "dependsOrder": "sequence",
            "problemMatcher": ["$msCompile"],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            // Primary "Windows dev mode" task: configure -> build -> run the receiver.
            // Runs from build/ so the renderer finds build/shaders/*.cso.
            "label": "Windows: Dev (Build & Run Receiver)",
            "type": "shell",
            "command": "${workspaceFolder}/build/Debug/ThunderLinkReceiver.exe",
            "args": [],
            "options": { "cwd": "${workspaceFolder}/build" },
            "dependsOn": ["Windows: Build (CMake Debug)"],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": "test",
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },

        // ---------------- Mac (sender) ----------------
        {
            "label": "Mac: Build (SwiftPM Debug)",
            "type": "shell",
            "command": "swift",
            "args": ["build"],
            "options": { "cwd": "${workspaceFolder}/mac_sender" },
            "problemMatcher": [],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            // Primary "Mac dev mode" task: swift run builds (debug) and launches the sender.
            // Requires Screen Recording + Accessibility permissions for the produced binary.
            "label": "Mac: Dev (Build & Run Sender)",
            "type": "shell",
            "command": "swift",
            "args": ["run", "ThunderLinkSender"],
            "options": { "cwd": "${workspaceFolder}/mac_sender" },
            "problemMatcher": [],
            "group": "test",
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },

        // ---------------- Auto-sync (git) ----------------
        {
            // Keeps this repo mirrored with origin/main while VSCode is open.
            // git.autofetch (settings.json) refreshes origin every 60s; this loop
            // notices the moment origin/main moves, then hands the pull + any
            // merge-conflict resolution to the `claude` CLI, and pushes.
            //
            // Auto-starts on folder open — the first time, VSCode asks to
            // "Allow Automatic Tasks"; accept it (Command Palette >
            // "Tasks: Manage Automatic Tasks" to change later). Stop it any time
            // by killing its terminal in the panel.
            //
            // It only acts when origin/main and HEAD differ, so an idle repo (or
            // just-uncommitted edits) triggers nothing — no commit churn.
            "label": "Git: Auto-sync (Claude-resolved)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "export PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\"; while true; do git fetch -q origin main 2>/dev/null; L=\"$(git rev-parse @ 2>/dev/null)\"; R=\"$(git rev-parse origin/main 2>/dev/null)\"; if [ -n \"$R\" ] && [ \"$L\" != \"$R\" ]; then echo '[autosync] origin/main moved — syncing via Claude'; claude -p 'In this git repository, sync the main branch with origin. Commit any local changes with a short message, merge origin/main, and resolve any merge conflicts so the result is correct and compiles (combine both sides intent; never leave conflict markers). Then push. Reply with a one-line summary only.' --permission-mode acceptEdits --allowedTools 'Bash Edit Read Grep Glob Write'; osascript -e 'display notification \"Synced with origin/main — Claude handled the merge/conflict. Open the Claude Code Sessions list to review.\" with title \"git-autosync\" sound name \"Glass\"' 2>/dev/null; fi; sleep 30; done"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile", "-Command",
                    "while ($true) { git fetch -q origin main 2>$null; $L = (git rev-parse '@' 2>$null); $R = (git rev-parse origin/main 2>$null); if ($R -and ($L -ne $R)) { Write-Host '[autosync] origin/main moved — syncing via Claude'; claude -p 'In this git repository, sync the main branch with origin. Commit any local changes with a short message, merge origin/main, and resolve any merge conflicts so the result is correct (combine both sides; never leave conflict markers). Then push. Reply with a one-line summary only.' --permission-mode acceptEdits --allowedTools 'Bash Edit Read Grep Glob Write'; try { Add-Type -AssemblyName System.Windows.Forms; Add-Type -AssemblyName System.Drawing; $ni = New-Object System.Windows.Forms.NotifyIcon; $ni.Icon = [System.Drawing.SystemIcons]::Information; $ni.Visible = $true; $ni.ShowBalloonTip(6000, 'git-autosync', 'Synced with origin/main — Claude handled the merge/conflict. Open the Claude Code Sessions list to review.', [System.Windows.Forms.ToolTipIcon]::Info); Start-Sleep -Seconds 6; $ni.Dispose() } catch { Write-Host 'Synced with origin/main — open Claude Sessions to review.' } }; Start-Sleep -Seconds 30 }"
                ]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "runOptions": { "runOn": "folderOpen" },
            "problemMatcher": [],
            "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true }
        }
    ]
}
