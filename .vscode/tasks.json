{
    // ThunderLink dev tasks. Both are cross-platform: each one runs the driver
    // script for the machine you are on and builds/runs that machine's half of
    // the system -- the receiver on Windows, the sender on macOS.
    //
    //   Build : checks the toolchain (CMake / MSVC / Git on Windows, Swift on
    //           macOS), offers to install anything missing, configures on first
    //           run, then compiles.
    //   Run   : rebuilds only when sources are newer than the built binary,
    //           then launches the app.
    //
    // Terminal > Run Task..., or Ctrl/Cmd+Shift+B for Build.
    // Defaults target the direct link (169.254.1.1 Mac / 169.254.1.2 PC), so no
    // arguments are needed; see docs/SETUP.md for runtime overrides.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Preview",
            "detail": "Build the shared local UI, then preview it on the saved loopback port.",
            "type": "process",
            "command": "/bin/sh",
            "args": ["${workspaceFolder}${/}shared_ui${/}deploy.sh", "build-preview"],
            "windows": { "command": "powershell.exe", "args": ["-NoProfile", "-File", "${workspaceFolder}${/}shared_ui${/}deploy.ps1", "build-preview"] },
            "options": { "cwd": "${workspaceFolder}${/}shared_ui" },
            "problemMatcher": [], "inAgents": true,
            "icon": { "id": "rocket", "color": "terminal.ansiCyan" },
            "runOptions": { "instanceLimit": 1, "instancePolicy": "terminateOldest", "reevaluateOnRerun": true },
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "Preview",
            "detail": "Preview the last production UI build without rebuilding.",
            "type": "process",
            "command": "/bin/sh",
            "args": ["${workspaceFolder}${/}shared_ui${/}deploy.sh", "preview"],
            "windows": { "command": "powershell.exe", "args": ["-NoProfile", "-File", "${workspaceFolder}${/}shared_ui${/}deploy.ps1", "preview"] },
            "options": { "cwd": "${workspaceFolder}${/}shared_ui" },
            "problemMatcher": [], "inAgents": true,
            "icon": { "id": "play-circle", "color": "terminal.ansiCyan" },
            "runOptions": { "instanceLimit": 1, "instancePolicy": "terminateOldest", "reevaluateOnRerun": true },
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "Clear",
            "detail": "Remove only generated shared UI outputs.",
            "type": "process",
            "command": "/bin/sh",
            "args": ["${workspaceFolder}${/}shared_ui${/}deploy.sh", "clear-build"],
            "windows": { "command": "powershell.exe", "args": ["-NoProfile", "-File", "${workspaceFolder}${/}shared_ui${/}deploy.ps1", "clear-build"] },
            "options": { "cwd": "${workspaceFolder}${/}shared_ui" },
            "problemMatcher": [], "inAgents": true,
            "icon": { "id": "trash", "color": "terminal.ansiYellow" }
        },
        {
            "label": "Reset",
            "detail": "Remove generated shared UI outputs and its local npm installation.",
            "type": "process",
            "command": "/bin/sh",
            "args": ["${workspaceFolder}${/}shared_ui${/}deploy.sh", "reset"],
            "windows": { "command": "powershell.exe", "args": ["-NoProfile", "-File", "${workspaceFolder}${/}shared_ui${/}deploy.ps1", "reset"] },
            "options": { "cwd": "${workspaceFolder}${/}shared_ui" },
            "problemMatcher": [], "inAgents": true,
            "icon": { "id": "debug-restart", "color": "terminal.ansiMagenta" }
        },
        {
            "label": "Build",
            "detail": "Check/install dependencies, then build this machine's ThunderLink app (Windows receiver or Mac sender).",
            "type": "process",
            "command": "/bin/sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "build"],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy", "Bypass",
                    "-File", "${workspaceFolder}\\scripts\\dev.ps1",
                    "-Task", "build"
                ]
            },
            "osx": {
                "command": "/bin/sh",
                "args": ["${workspaceFolder}/scripts/dev.sh", "build"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [
                "$msCompile",
                {
                    "owner": "swift",
                    "source": "swiftc",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^(.*\\.swift):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Run",
            "detail": "Rebuild only if the build is out of date, then launch this machine's ThunderLink app.",
            "type": "process",
            "command": "/bin/sh",
            "args": ["${workspaceFolder}/scripts/dev.sh", "run"],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy", "Bypass",
                    "-File", "${workspaceFolder}\\scripts\\dev.ps1",
                    "-Task", "run"
                ]
            },
            "osx": {
                "command": "/bin/sh",
                "args": ["${workspaceFolder}/scripts/dev.sh", "run"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": [
                "$msCompile",
                {
                    "owner": "swift",
                    "source": "swiftc",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^(.*\\.swift):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
